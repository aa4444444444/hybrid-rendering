#version 460 core

#define M_PI 3.1415926538
#define BVH_STACK_SIZE 64

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout (rgba16f, binding = 0) writeonly uniform image2D gReflectionRaw;

// G-buffer inputs
layout (binding = 1) uniform sampler2D gPosition;
layout (binding = 2) uniform sampler2D gNormal;
layout (binding = 3) uniform sampler2D gAlbedoSpec;

// Blue noise for roughness
layout (binding = 4) uniform sampler2D blueNoiseTexture;

// Frame Index
uniform int randomSeed;

// Camera position
uniform vec3 viewPos;

// Triangles in Scene
struct Triangle {
    vec4 v0;
    vec4 v1;
    vec4 v2;
    vec4 normal;
    vec4 diffuseColor0;
    vec4 diffuseColor1;
    vec4 diffuseColor2;
    uint id;
    uint materialID;
    uint pad0;
    uint pad1;
};

layout(std430, binding = 3) buffer Triangles {
    Triangle tris[];
};

// Bounding Volume Hierarchy
struct BVHNode {
    vec4 lminLeft;   // xyz = left child aabbMin, w = left  child index
    vec4 lmaxRight;  // xyz = left child aabbMax, w = right child index
    vec4 rminCount;  // xyz = right child aabbMin, w = triCount
    vec4 rmaxFirst;  // xyz = right child aabbMax, w = firstTri
};

layout(std430, binding = 4) buffer BackpackBVHNodes { BVHNode backpackNodes[]; };
layout(std430, binding = 7) buffer FloorBVHNodes    { BVHNode floorNodes[]; };

// Materials
struct Material {
    vec4  albedo;       // xyz = colour, w is unused
    float reflectivity; // [0,1]
    float roughness;    // [0,1]
    float pad0;
    float pad1;
};

layout(std430, binding = 5) buffer Materials {
    Material materials[];
};

// One entry per object instance, updated every frame. 
struct Instance {
    mat4 transform;
    mat4 worldToObject;
    mat4 inverseTranspose;
    uvec4 blasInfo;
};
layout(std430, binding = 6) buffer Instances { Instance instances[]; };

// Light
struct Light { vec3 Position; vec3 Color; float Linear; float Quadratic; float MaxDistance; };
uniform Light light;

vec2 blueNoise(ivec2 pixelCoords) {
    // Texture size
    int N = 128;
    
    // Combine pixel coords with randomSeed to randomize sampling
    int f = (pixelCoords.x * 73856093 ^ pixelCoords.y * 19349663 ^ randomSeed * 83492791) % N;
    int g = (pixelCoords.y * 83492791 ^ pixelCoords.x * 19349663 ^ randomSeed * 73856093) % N;

    // Compute wrapped pixel coordinate in the blue noise texture
    ivec2 bnPixel = ivec2(f, g);

    // Normalize to [0,1] for sampling
    vec2 uv = (vec2(bnPixel) + 0.5) / float(N);

    // Sample the texture
    return texture(blueNoiseTexture, uv).rg;
}

bool intersectAABB(vec3 ro, vec3 invRd, vec3 bmin, vec3 bmax, float maxDist, out float tEnter) {
    vec3 t0 = (bmin - ro) * invRd;
    vec3 t1 = (bmax - ro) * invRd;
    vec3 tMin = min(t0, t1);
    vec3 tMax = max(t0, t1);
    tEnter = max(max(tMin.x, tMin.y), tMin.z);
    float tExit = min(min(tMax.x, tMax.y), tMax.z);
    return (tExit >= max(tEnter, 0.0)) && (tEnter < maxDist);
}

// Returns hit distance t (or -1 on miss), and sets u,v barycentric coords.
// The third barycentric weight is w = 1 - u - v.
float intersectTriangle(vec3 ro, vec3 rd, Triangle tri, out float u, out float v) {
    vec3 e1 = tri.v1.xyz - tri.v0.xyz;
    vec3 e2 = tri.v2.xyz - tri.v0.xyz;
    vec3 p  = cross(rd, e2);
    float det = dot(e1, p);
    if (abs(det) < 1e-6) { u = 0.0; v = 0.0; return -1.0; }

    float invDet = 1.0 / det;
    vec3 s = ro - tri.v0.xyz;
    u = dot(s, p) * invDet;
    if (u < -1e-6 || u > 1.0 + 1e-6) { v = 0.0; return -1.0; }

    vec3 q = cross(s, e1);
    v = dot(rd, q) * invDet;
    if (v < -1e-6 || u + v > 1.0 + 1e-6) return -1.0;

    float t = dot(e2, q) * invDet;
    return (t > 1e-4) ? t : -1.0;
}

// Returns the index of the closest hit triangle (in the sorted SSBO), or -1.
// Also returns the object-space hit distance tHit and barycentrics hitU/hitV.
int traverseBLAS(vec3 origin, vec3 dir, inout float tHit,
                 out float hitU, out float hitV,
                 uint blasOffset, uint nodeSet) {
    vec3 invDir = 1.0/dir;
    int hitIdx = -1;
    int stack[BVH_STACK_SIZE]; 
    int sp = 0; 
    stack[sp++] = 0;
    while (sp > 0) {
        int ni = stack[--sp];
        BVHNode n = (nodeSet == 0u) ? backpackNodes[ni] : floorNodes[ni];
        uint left = floatBitsToUint(n.lminLeft.w), right = floatBitsToUint(n.lmaxRight.w);
        uint triCount = floatBitsToUint(n.rminCount.w), firstTri = floatBitsToUint(n.rmaxFirst.w);
        if (triCount > 0u) {
            for (uint i = firstTri; i < firstTri+triCount; ++i) {
                float u,v,t = intersectTriangle(origin, dir, tris[blasOffset+i], u, v);
                if (t > 0.0 && t < tHit) { 
                    tHit = t; 
                    hitIdx = int(blasOffset+i); 
                    hitU = u; 
                    hitV = v; 
                }
            }
        } else {
            float tL, tR;
            bool hL = intersectAABB(origin, invDir, n.lminLeft.xyz, n.lmaxRight.xyz, tHit, tL);
            bool hR = intersectAABB(origin, invDir, n.rminCount.xyz, n.rmaxFirst.xyz, tHit, tR);
            if(hL && hR){
                if(tL < tR){
                    if(sp < BVH_STACK_SIZE)
                        stack[sp++] = int(right);
                    if(sp < BVH_STACK_SIZE)
                        stack[sp++] = int(left);
                } else {
                    if(sp < BVH_STACK_SIZE)
                        stack[sp++] = int(left); 
                    if(sp < BVH_STACK_SIZE)
                        stack[sp++] = int(right);
                }
            } else if(hL) {
                if(sp < BVH_STACK_SIZE)
                    stack[sp++] = int(left);
            } else if (hR) {
                if(sp < BVH_STACK_SIZE)
                    stack[sp++] = int(right);
            }
        }
    }

    return hitIdx;
}


// Loops over all instances. For each one, transforms the ray to object space,
// finds the closest hit in the BLAS, then converts the hit back to world space.
// Returns the triangle index of the overall closest hit, or -1 on miss.
// Also outputs world-space hit position, world-space normal, and barycentrics.
int traverseTLAS(vec3 wOrigin, vec3 wDir,
                 out vec3 wHitPos, out vec3 wHitNormal,
                 out float hitU, out float hitV) {
    float bestT = 1e30;
    int bestIdx = -1; 
    uint bestInst = 0u;
    float bestU = 0.0, bestV = 0.0;
    uint n = uint(instances.length());
    for (uint i = 0u; i < n; ++i) {
        vec3 oOrigin = (instances[i].worldToObject * vec4(wOrigin,1.0)).xyz;
        vec3 oDir = (instances[i].worldToObject * vec4(wDir, 0.0)).xyz;

        // Cull with current best distance converted to object space
        float oCull = length((instances[i].worldToObject * vec4(wOrigin + wDir * bestT, 1.0)).xyz - oOrigin);
        float tHit = oCull; 
        float u,v;
        int idx = traverseBLAS(oOrigin, oDir, tHit, u, v, instances[i].blasInfo.x, instances[i].blasInfo.z);
        if (idx >= 0) {
            vec3 wCand = (instances[i].transform * vec4(oOrigin + oDir * tHit, 1.0)).xyz;
            float wT = length(wCand - wOrigin);
            if (wT < bestT){ 
                bestT = wT; 
                bestIdx = idx; 
                bestInst = i; 
                bestU = u; 
                bestV = v; 
            }
        }
    }

    if (bestIdx < 0) 
        return -1;

    // Reconstruct world-space hit
    vec3 oOrigin = (instances[bestInst].worldToObject * vec4(wOrigin, 1.0)).xyz;
    vec3 oHit = (instances[bestInst].worldToObject * vec4(wOrigin + wDir * bestT, 1.0)).xyz;
    wHitPos = (instances[bestInst].transform * vec4(oHit, 1.0)).xyz;
    wHitNormal = normalize((instances[bestInst].inverseTranspose * vec4(normalize(tris[bestIdx].normal.xyz), 0.0)).xyz);
    hitU = bestU;
    hitV = bestV;
    return bestIdx;
}

vec3 shadeHit(vec3 hitPos, vec3 hitNormal, vec3 diffuse) {
    vec3  ambient = diffuse * 0.1;
    vec3  toLight = light.Position - hitPos;
    float dist = length(toLight);
    if (dist >= light.MaxDistance) return ambient;

    vec3  lightDir = toLight / dist;
    float diff = max(dot(hitNormal, lightDir), 0.0);
    float atten = 1.0 / (1.0 + light.Linear * dist + light.Quadratic * dist * dist);
    vec3  diffuse_ = diff * diffuse * light.Color * atten;

    return ambient + diffuse_;
}

void main(){
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
	ivec2 dims = imageSize(gReflectionRaw);
    if (pixelCoords.x >= dims.x || pixelCoords.y >= dims.y)
        return;

    // Since our gPosition stores world-space coordinates, this is the world pos of an object
    // (if it exists) at the pixel coordiantes. 
	vec3 objectWorldPos = texelFetch(gPosition, pixelCoords, 0).xyz;

    // Similarly, our world-space normal at the pixel coordinates
	vec3 objectWorldNormal = normalize(texelFetch(gNormal, pixelCoords, 0).xyz);

    float specular = texelFetch(gAlbedoSpec, pixelCoords, 0).a;

    // No geometry at this pixel or surface is not reflective
    if (length(objectWorldPos) == 0.0 || specular < 0.01) {
        imageStore(gReflectionRaw, pixelCoords, vec4(0.0));
        return;
    }

    // reflection ray
    vec3 viewDir = normalize(objectWorldPos - viewPos);
    vec3 reflectDir = reflect(viewDir, objectWorldNormal);

    // Offset origin along normal to avoid self intersection
    vec3 origin = objectWorldPos + objectWorldNormal * 0.005f;

    vec3 worldHitPos, worldHitNormal;
    float hitU, hitV;
    int hitIdx = traverseTLAS(origin, reflectDir, worldHitPos, worldHitNormal, hitU, hitV);

    vec3 reflectedColor = vec3(0.0);

    if (hitIdx >= 0) {
        Triangle hitTri = tris[hitIdx];
        Material hitMat = materials[hitTri.materialID];

        float w = 1.0 - hitU - hitV;
        vec3 diffuse = w * hitTri.diffuseColor0.xyz + hitU * hitTri.diffuseColor1.xyz + hitV * hitTri.diffuseColor2.xyz;

        reflectedColor = shadeHit(worldHitPos, worldHitNormal, diffuse);

        // Scale by the material's reflectivity so very reflective surfaces contribute more than dull ones
        reflectedColor *= hitMat.reflectivity;
    }

    // Also scale by the surface's own specular — highly specular surfaces show reflections more prominently
    reflectedColor *= specular;

    imageStore(gReflectionRaw, pixelCoords, vec4(reflectedColor, 1.0));
}